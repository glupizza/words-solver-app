# Port for backend
PORT=8000

# Optional: override default assets paths
# MODEL_PATH=/absolute/or/relative/path/to/letter_recognition_model.h5
# DICTIONARY_PATH=/absolute/or/relative/path/to/cleaned_filtered_russian_words_no_past.json

# Optional: reduce TensorFlow logs
TF_CPP_MIN_LOG_LEVEL=3

# Required: configure outside the image; never commit real values.
REJECTED_WORDS_DB_PATH=/data/rejected_words.sqlite3
FLASK_SECRET_KEY=
ADMIN_PASSWORD_HASH=
